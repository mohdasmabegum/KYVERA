# =====================================================================
# KYVERA by MRA - Environment Variables Configuration
# =====================================================================

# 1. FRONTEND (Vite / Vercel / Netlify)
# Zero environment variables required for Vercel/Netlify deployment!
# The web app runs out-of-the-box with self-hosted browser storage.

VITE_APP_TITLE=KYVERA by MRA
VITE_API_URL=http://localhost:5000/api

# 2. BACKEND (Node.js Express & Self-Hosted Database Server)
PORT=5000
NODE_ENV=production
DATABASE_TYPE=sqlite # Options: sqlite, postgresql, mysql
DATABASE_URL=./backend/kyvera.db
JWT_SECRET=kyvera_mra_enterprise_secret_key_2026
